{
  "name": "evolua-estudos",
  "private": true,
  "version": "1.0.0",
  "description": "Evolua Meus Estudos — organize disciplinas, prazos e o progresso do curso.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler pages deploy --branch main",
    "dev:api": "npm run build && wrangler d1 migrations apply evolua-meus-estudos --local --persist-to .wrangler/local && wrangler pages dev --port 8788 --persist-to .wrangler/local",
    "db:migrate": "wrangler d1 migrations apply evolua-meus-estudos --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
